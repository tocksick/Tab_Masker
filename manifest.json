{
  "manifest_version": 3,
  "name": "Tab Masker",
  "version": "1.1.0",
  "description": "Maskiert Domainnamen und Favicons in Tabs mit zufälligen, pro Domain konsistenten Namen und Icons – ideal für Screensharing oder öffentliche Bildschirme.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Tab Masker",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "tabs", "alarms", "notifications"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["common/mask.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
